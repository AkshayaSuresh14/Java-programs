import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner in=new Scanner(System.in);
        int amount=in.nextInt();
        in.nextLine();
        String notesStatus = in.nextLine();
        if(notesStatus.equals("available") && amount%100==0){
            System.out.println("Amount "+amount+" can be withdrawn");
        }
        else if(notesStatus.equals("not available")&&amount%500==0){
            System.out.println("Amount "+amount+" can be withdrawn");
        }
        else{
                System.out.println("Enter amount in multiples of 500");
        }
        
    }
}
